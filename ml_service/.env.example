# Copy to ml_service/.env (never commit the real file)
# Same database the Express backend uses. Prefer a dedicated MongoDB user with
#   read on geographicfeatures, readWrite on roadsegmentfeatures.
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/safira?retryWrites=true&w=majority
# Only needed if MONGO_URI has no database name
# MONGO_DB_NAME=safira

# Shared secret the Express backend sends as X-API-Key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ML_SERVICE_API_KEY=change-me

# Optional overrides
# ML_DATA_DIR=./data
# ML_MODEL_DIR=./models
# ML_REPORT_DIR=./reports
